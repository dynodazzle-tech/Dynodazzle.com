<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dyno Dazzle – Digital Marketing Agency</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@300;400;600;700;900&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet">
<style>
  :root {
    --red: #E8342A;
    --navy: #1B2C6B;
    --gold: #F5A623;
    --white: #FFFFFF;
    --offwhite: #F7F5F2;
    --dark: #0E1428;
    --gray: #8A8FA8;
    --light-gray: #EEF0F8;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Montserrat', sans-serif; background: var(--dark); color: var(--white); overflow-x: hidden; }

  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: var(--dark); }
  ::-webkit-scrollbar-thumb { background: var(--red); border-radius: 2px; }

  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 60px;
    background: rgba(14,20,40,0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(232,52,42,0.15);
    transition: padding .3s;
  }
  .logo-wrap { display: flex; align-items: center; gap: 14px; text-decoration: none; }
  .logo-icon { width: 54px; height: 54px; position: relative; display: flex; align-items: center; justify-content: center; }
  .logo-icon svg { width: 54px; height: 54px; }
  .logo-text { line-height: 1; }
  .logo-text .brand { font-family: 'Bebas Neue', sans-serif; font-size: 28px; color: var(--red); letter-spacing: 2px; }
  .logo-text .sub { font-size: 8px; font-weight: 700; color: var(--navy); letter-spacing: 3px; background: var(--white); padding: 2px 6px; border-radius: 2px; }
  .nav-links { display: flex; gap: 36px; list-style: none; }
  .nav-links a { text-decoration: none; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.7); transition: color .2s; }
  .nav-links a:hover { color: var(--red); }
  .nav-cta { background: var(--red); color: var(--white); border: none; cursor: pointer; padding: 12px 28px; font-family: 'Montserrat', sans-serif; font-size: 11px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%); transition: background .2s, transform .2s; text-decoration: none; display: inline-block; }
  .nav-cta:hover { background: #c42920; transform: translateY(-1px); }

  #hero { min-height: 100vh; display: flex; align-items: center; position: relative; overflow: hidden; padding: 120px 60px 60px; }
  .hero-bg { position: absolute; inset: 0; z-index: 0; background: radial-gradient(ellipse 80% 60% at 70% 40%, rgba(27,44,107,0.5) 0%, transparent 70%), radial-gradient(ellipse 50% 50% at 10% 80%, rgba(232,52,42,0.12) 0%, transparent 60%); }
  .hero-grid { position: absolute; inset: 0; z-index: 0; background-image: linear-gradient(rgba(27,44,107,0.15) 1px, transparent 1px), linear-gradient(90deg, rgba(27,44,107,0.15) 1px, transparent 1px); background-size: 60px 60px; animation: gridMove 20s linear infinite; }
  @keyframes gridMove { from { transform: translateY(0); } to { transform: translateY(60px); } }
  .hero-arc { position: absolute; right: -80px; top: 50%; transform: translateY(-50%); width: 700px; height: 700px; z-index: 1; border: 2px solid rgba(232,52,42,0.2); border-radius: 50%; animation: spin 40s linear infinite; }
  .hero-arc::before { content: ''; position: absolute; inset: 30px; border: 1px solid rgba(27,44,107,0.4); border-radius: 50%; animation: spin 25s linear infinite reverse; }
  .hero-arc::after { content: ''; position: absolute; inset: 80px; border: 2px dashed rgba(245,166,35,0.2); border-radius: 50%; }
  @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  .hero-content { position: relative; z-index: 2; max-width: 680px; }
  .hero-tag { display: inline-flex; align-items: center; gap: 10px; background: rgba(232,52,42,0.1); border: 1px solid rgba(232,52,42,0.3); padding: 8px 18px; border-radius: 2px; margin-bottom: 30px; font-size: 11px; font-weight: 800; letter-spacing: 3px; text-transform: uppercase; color: var(--red); animation: fadeUp .8s ease both; }
  .hero-tag span { width: 8px; height: 8px; background: var(--red); border-radius: 50%; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.4)} }
  .hero-headline { font-family: 'Bebas Neue', sans-serif; font-size: clamp(64px, 10vw, 110px); line-height: .92; letter-spacing: 2px; margin-bottom: 24px; animation: fadeUp .8s .15s ease both; }
  .hero-headline .line-red { color: var(--red); }
  .hero-headline .line-white { color: var(--white); }
  .hero-headline .line-outline { -webkit-text-stroke: 2px rgba(255,255,255,0.3); color: transparent; }
  .hero-sub { font-size: 15px; font-weight: 400; color: rgba(255,255,255,0.65); line-height: 1.8; max-width: 480px; margin-bottom: 44px; animation: fadeUp .8s .3s ease both; }
  .hero-btns { display: flex; gap: 16px; flex-wrap: wrap; animation: fadeUp .8s .45s ease both; }
  .btn-primary { background: var(--red); color: var(--white); padding: 16px 36px; text-decoration: none; font-size: 12px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; clip-path: polygon(10px 0%, 100% 0%, calc(100% - 10px) 100%, 0% 100%); transition: all .2s; display: inline-block; }
  .btn-primary:hover { background: #c42920; transform: translateY(-2px); }
  .btn-secondary { border: 1px solid rgba(255,255,255,0.25); color: var(--white); padding: 16px 36px; text-decoration: none; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; transition: all .2s; display: inline-block; background: transparent; }
  .btn-secondary:hover { border-color: var(--red); color: var(--red); }
  .hero-stats { position: absolute; bottom: 60px; right: 60px; z-index: 2; display: flex; gap: 40px; animation: fadeUp .8s .6s ease both; }
  .stat { text-align: right; }
  .stat-num { font-family: 'Bebas Neue', sans-serif; font-size: 42px; color: var(--gold); line-height: 1; }
  .stat-label { font-size: 10px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--gray); }
  @keyframes fadeUp { from { opacity:0; transform:translateY(30px); } to { opacity:1; transform:translateY(0); } }

  .marquee-section { background: var(--red); padding: 18px 0; overflow: hidden; border-top: 1px solid rgba(255,255,255,0.1); border-bottom: 1px solid rgba(255,255,255,0.1); }
  .marquee-track { display: flex; gap: 0; white-space: nowrap; animation: marquee 25s linear infinite; }
  .marquee-item { display: inline-flex; align-items: center; gap: 24px; padding: 0 24px; font-size: 12px; font-weight: 800; letter-spacing: 3px; text-transform: uppercase; color: var(--white); }
  .marquee-dot { width: 6px; height: 6px; background: rgba(255,255,255,0.5); border-radius: 50%; flex-shrink: 0; }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  section { padding: 100px 60px; position: relative; }
  .section-tag { font-size: 10px; font-weight: 800; letter-spacing: 4px; text-transform: uppercase; color: var(--red); margin-bottom: 16px; display: flex; align-items: center; gap: 12px; }
  .section-tag::before { content: ''; width: 30px; height: 2px; background: var(--red); }
  .section-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(40px, 6vw, 72px); line-height: 1; letter-spacing: 1px; margin-bottom: 20px; }

  #services { background: var(--offwhite); color: var(--dark); }
  #services .section-tag { color: var(--red); }
  #services .section-tag::before { background: var(--red); }
  .services-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: end; margin-bottom: 70px; }
  .services-intro p { font-size: 15px; color: #555; line-height: 1.8; }
  .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
  .service-card { background: var(--white); padding: 44px 36px; position: relative; overflow: hidden; cursor: pointer; transition: transform .3s; border: 1px solid #e8e8e8; }
  .service-card::before { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 3px; background: var(--red); transform: scaleX(0); transition: transform .3s; transform-origin: left; }
  .service-card:hover::before { transform: scaleX(1); }
  .service-card:hover { transform: translateY(-4px); }
  .service-num { font-family: 'Bebas Neue', sans-serif; font-size: 64px; line-height: 1; color: rgba(232,52,42,0.08); position: absolute; top: 20px; right: 24px; transition: color .3s; }
  .service-card:hover .service-num { color: rgba(232,52,42,0.15); }
  .service-icon { width: 52px; height: 52px; background: var(--dark); border-radius: 4px; display: flex; align-items: center; justify-content: center; margin-bottom: 24px; font-size: 22px; }
  .service-title { font-family: 'Bebas Neue', sans-serif; font-size: 26px; letter-spacing: 1px; color: var(--dark); margin-bottom: 12px; }
  .service-desc { font-size: 13px; color: #666; line-height: 1.7; }
  .service-arrow { margin-top: 28px; display: inline-flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: var(--red); }

  #process { background: var(--dark); }
  .process-header { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: end; margin-bottom: 80px; }
  .process-header p { color: rgba(255,255,255,0.55); font-size: 15px; line-height: 1.8; }
  .process-steps { position: relative; }
  .process-line { position: absolute; top: 28px; left: 28px; right: 28px; height: 2px; background: linear-gradient(90deg, var(--red), var(--navy), var(--gold), var(--red)); z-index: 0; }
  .steps-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; position: relative; z-index: 1; }
  .step { text-align: center; }
  .step-circle { width: 56px; height: 56px; border-radius: 50%; background: var(--dark); border: 2px solid var(--red); display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; font-family: 'Bebas Neue', sans-serif; font-size: 20px; color: var(--red); transition: background .3s, color .3s; position: relative; z-index: 2; }
  .step:hover .step-circle { background: var(--red); color: var(--white); }
  .step-title { font-weight: 800; font-size: 13px; color: var(--white); margin-bottom: 8px; letter-spacing: 1px; }
  .step-desc { font-size: 11.5px; color: var(--gray); line-height: 1.6; }

  #why { background: var(--navy); }
  .why-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  .why-visual { position: relative; height: 480px; display: flex; align-items: center; justify-content: center; }
  .why-ring { position: absolute; border-radius: 50%; border: 1px solid rgba(232,52,42,0.25); }
  .why-ring:nth-child(1) { width: 400px; height: 400px; animation: spin 30s linear infinite; border-style: dashed; }
  .why-ring:nth-child(2) { width: 280px; height: 280px; border-color: rgba(245,166,35,0.3); animation: spin 20s linear infinite reverse; }
  .why-ring:nth-child(3) { width: 160px; height: 160px; border-color: rgba(255,255,255,0.2); }
  .why-center { position: relative; z-index: 2; text-align: center; background: rgba(14,20,40,0.8); backdrop-filter: blur(10px); border: 1px solid rgba(232,52,42,0.3); padding: 36px; clip-path: polygon(20px 0%, 100% 0%, calc(100% - 20px) 100%, 0% 100%); }
  .why-center-num { font-family: 'Bebas Neue', sans-serif; font-size: 72px; color: var(--red); line-height: 1; }
  .why-center-label { font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: rgba(255,255,255,0.6); }
  .why-points { display: flex; flex-direction: column; gap: 24px; }
  .why-point { display: flex; gap: 20px; align-items: flex-start; padding: 24px; background: rgba(255,255,255,0.04); border-left: 3px solid transparent; transition: border-color .3s, background .3s; cursor: pointer; }
  .why-point:hover { border-left-color: var(--red); background: rgba(232,52,42,0.06); }
  .why-point-icon { width: 44px; height: 44px; background: rgba(232,52,42,0.15); border-radius: 4px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 18px; }
  .why-point-title { font-weight: 800; font-size: 14px; margin-bottom: 6px; color: var(--white); }
  .why-point-desc { font-size: 13px; color: rgba(255,255,255,0.55); line-height: 1.7; }

  #packages { background: #0a0f1e; }
  .packages-header { text-align: center; margin-bottom: 60px; }
  .packages-header p { color: var(--gray); font-size: 15px; max-width: 520px; margin: 16px auto 0; line-height: 1.8; }
  .packages-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
  .pkg-card { background: rgba(255,255,255,0.03); padding: 48px 36px; border: 1px solid rgba(255,255,255,0.06); position: relative; overflow: hidden; transition: transform .3s; }
  .pkg-card.featured { background: var(--red); border-color: var(--red); transform: scaleY(1.02); z-index: 1; }
  .pkg-card:not(.featured):hover { transform: translateY(-4px); }
  .pkg-badge { position: absolute; top: 0; right: 0; background: var(--gold); color: var(--dark); font-size: 9px; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; padding: 6px 16px; clip-path: polygon(8px 0%, 100% 0%, 100% 100%, 0% 100%); }
  .pkg-name { font-size: 11px; font-weight: 800; letter-spacing: 3px; text-transform: uppercase; opacity: .6; margin-bottom: 12px; }
  .pkg-price { font-family: 'Bebas Neue', sans-serif; font-size: 56px; line-height: 1; margin-bottom: 4px; }
  .pkg-period { font-size: 12px; opacity: .6; margin-bottom: 32px; }
  .pkg-divider { height: 1px; background: rgba(255,255,255,0.1); margin-bottom: 32px; }
  .pkg-features { list-style: none; display: flex; flex-direction: column; gap: 14px; margin-bottom: 40px; }
  .pkg-features li { display: flex; align-items: center; gap: 12px; font-size: 13px; opacity: .85; }
  .pkg-features li::before { content: '✓'; font-weight: 900; color: var(--gold); width: 18px; height: 18px; background: rgba(245,166,35,0.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 10px; flex-shrink: 0; }
  .pkg-card.featured .pkg-features li::before { background: rgba(255,255,255,0.2); color: var(--white); }
  .pkg-btn { display: block; text-align: center; padding: 14px 24px; font-size: 11px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; text-decoration: none; transition: all .2s; border: 2px solid rgba(255,255,255,0.2); color: var(--white); clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%); }
  .pkg-card.featured .pkg-btn { background: var(--white); color: var(--red); border-color: var(--white); }
  .pkg-btn:hover { background: var(--red); border-color: var(--red); color: var(--white); }
  .pkg-card.featured .pkg-btn:hover { background: var(--dark); border-color: var(--dark); color: var(--white); }

  #results { background: var(--offwhite); color: var(--dark); }
  #results .section-tag { color: var(--red); }
  #results .section-tag::before { background: var(--red); }
  .results-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; margin-top: 60px; }
  .result-card { background: var(--white); padding: 44px 32px; text-align: center; border: 1px solid #e8e8e8; position: relative; overflow: hidden; }
  .result-card::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--red), var(--gold)); }
  .result-num { font-family: 'Bebas Neue', sans-serif; font-size: 64px; line-height: 1; color: var(--red); margin-bottom: 8px; }
  .result-label { font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #666; }
  .testimonials { margin-top: 80px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .testi { background: var(--dark); padding: 36px; color: var(--white); position: relative; border-top: 3px solid var(--red); }
  .testi-quote { font-size: 64px; font-family: 'Playfair Display', serif; color: var(--red); line-height: .8; margin-bottom: 16px; }
  .testi-text { font-size: 14px; color: rgba(255,255,255,0.7); line-height: 1.8; margin-bottom: 24px; font-style: italic; }
  .testi-author { font-size: 12px; font-weight: 800; letter-spacing: 1px; color: var(--gold); }
  .testi-role { font-size: 11px; color: var(--gray); }

  #contact { background: var(--dark); }
  .contact-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; }
  .contact-info h2 { font-family: 'Bebas Neue', sans-serif; font-size: clamp(40px, 5vw, 64px); line-height: 1; margin-bottom: 24px; }
  .contact-info p { color: rgba(255,255,255,0.55); font-size: 15px; line-height: 1.8; margin-bottom: 44px; }
  .contact-details { display: flex; flex-direction: column; gap: 20px; }
  .contact-item { display: flex; align-items: center; gap: 16px; }
  .contact-item-icon { width: 44px; height: 44px; background: rgba(232,52,42,0.1); border: 1px solid rgba(232,52,42,0.2); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; border-radius: 4px; }
  .contact-item-text span { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--gray); display: block; }
  .contact-item-text a { color: var(--white); text-decoration: none; font-size: 14px; font-weight: 600; transition: color .2s; }
  .contact-item-text a:hover { color: var(--red); }

  .contact-form { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); padding: 48px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
  .form-group { margin-bottom: 16px; }
  .form-group label { display: block; font-size: 10px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: var(--gray); margin-bottom: 8px; }
  .form-group input, .form-group select, .form-group textarea { width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: var(--white); padding: 14px 16px; font-family: 'Montserrat', sans-serif; font-size: 13px; outline: none; transition: border-color .2s; border-radius: 0; appearance: none; }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--red); }
  .form-group textarea { resize: vertical; min-height: 120px; }
  .form-group select option { background: var(--dark); }

  /* ── WHATSAPP SUBMIT BUTTON ── */
  .form-submit {
    width: 100%; background: #25D366; color: var(--white); border: none; cursor: pointer;
    padding: 18px; font-family: 'Montserrat', sans-serif; font-size: 13px;
    font-weight: 800; letter-spacing: 2px; text-transform: uppercase;
    clip-path: polygon(10px 0%, 100% 0%, calc(100% - 10px) 100%, 0% 100%);
    transition: background .2s, transform .2s; margin-top: 8px;
    display: flex; align-items: center; justify-content: center; gap: 10px;
  }
  .form-submit:hover { background: #1ebe5d; transform: translateY(-1px); }
  .form-submit svg { width: 20px; height: 20px; flex-shrink: 0; }

  /* ── REQUIRED FIELD STAR ── */
  .req { color: var(--red); }

  /* ── VALIDATION ERROR ── */
  .field-error { border-color: var(--red) !important; }
  .error-msg { font-size: 10px; color: var(--red); margin-top: 4px; font-weight: 600; display: none; }
  .error-msg.show { display: block; }

  footer { background: #050810; padding: 60px 60px 30px; border-top: 1px solid rgba(232,52,42,0.15); }
  .footer-inner { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 60px; margin-bottom: 60px; }
  .footer-brand p { font-size: 13px; color: var(--gray); line-height: 1.8; margin: 16px 0 24px; max-width: 280px; }
  .footer-socials { display: flex; gap: 12px; }
  .social-btn { width: 38px; height: 38px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 14px; color: var(--gray); border-radius: 4px; transition: all .2s; }
  .social-btn:hover { background: var(--red); border-color: var(--red); color: var(--white); }
  .footer-col h4 { font-size: 11px; font-weight: 800; letter-spacing: 3px; text-transform: uppercase; color: var(--white); margin-bottom: 20px; }
  .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .footer-col ul a { text-decoration: none; font-size: 13px; color: var(--gray); transition: color .2s; }
  .footer-col ul a:hover { color: var(--red); }
  .footer-bottom { display: flex; justify-content: space-between; align-items: center; padding-top: 30px; border-top: 1px solid rgba(255,255,255,0.05); }
  .footer-bottom p { font-size: 12px; color: var(--gray); }
  .footer-bottom span { color: var(--red); }

  .float-cta { position: fixed; bottom: 32px; right: 32px; z-index: 99; background: #25D366; color: var(--white); width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 22px; text-decoration: none; box-shadow: 0 8px 30px rgba(37,211,102,0.4); animation: floatBounce 3s ease-in-out infinite; transition: transform .2s; }
  .float-cta:hover { transform: scale(1.1); }
  @keyframes floatBounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }

  @media (max-width: 900px) {
    nav { padding: 16px 24px; }
    .nav-links { display: none; }
    section { padding: 70px 24px; }
    #hero { padding: 120px 24px 60px; }
    .hero-stats { display: none; }
    .hero-arc { display: none; }
    .services-intro, .services-grid, .process-header { grid-template-columns: 1fr; }
    .steps-row { grid-template-columns: 1fr 1fr; }
    .process-line { display: none; }
    .why-inner, .packages-grid, .contact-inner, .footer-inner { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
    .results-grid { grid-template-columns: repeat(2, 1fr); }
    .testimonials { grid-template-columns: 1fr; }
  }
</style>
